{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["title", "key", "mode", "meter", "measures"],
  "properties": {"title": {"type": "string", "minLength": 1}, "subtitle": {"type": "string"}, "composer": {"type": "string"}, "artist": {"type": "string"}, "key": {"type": "string", "pattern": "^[A-G](?:b|#)?$"}, "mode": {"enum": ["major", "minor"]}, "meter": {"$ref": "#/$defs/meter"}, "tempo": {"type": "integer", "minimum": 1}, "style": {"type": "string"}, "pickup": {"type": "string", "pattern": "^[0-9]+/[1-9][0-9]*$"}, "engraving": {"type": "object"}, "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}, "measures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measure"}}},
  "$defs": {
    "meter": {"type": "object", "additionalProperties": false, "required": ["beats", "beat_type"], "properties": {"beats": {"type": "integer", "minimum": 1}, "beat_type": {"type": "integer", "enum": [1,2,4,8,16]}}},
    "position": {"type": "object", "additionalProperties": false, "required": ["beat"], "properties": {"beat": {"type": "integer", "minimum": 1}, "offset": {"type": "string", "pattern": "^-?[0-9]+/[1-9][0-9]*$"}}},
    "harmony": {"type": "object", "additionalProperties": false, "required": ["symbol", "onset"], "properties": {"symbol": {"type": "string", "minLength": 1}, "onset": {"$ref": "#/$defs/position"}, "bass": {"type": "string"}, "extensions": {"type": "array", "items": {"type": "string"}}, "alterations": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "source": {"type": "string"}}},
    "section": {"type": "object", "additionalProperties": false, "required": ["name", "starting_measure"], "properties": {"name": {"type": "string", "minLength": 1}, "starting_measure": {"type": "integer", "minimum": 1}, "rehearsal_mark": {"type": "string"}, "notes": {"type": "string"}}},
    "measure": {"type": "object", "additionalProperties": false, "required": ["number", "section", "harmony"], "properties": {"number": {"type": "integer", "minimum": 1}, "section": {"type": "string"}, "meter": {"$ref": "#/$defs/meter"}, "harmony": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/harmony"}}, "holds": {"type": "array"}, "rhythmic_annotations": {"type": "array"}, "ending": {"type": "string"}, "repeat": {"type": "string"}}}
  }
}
